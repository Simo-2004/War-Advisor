# --- Progetto: cartelle locali/generate, non da versionare ---
# Ancorate alla radice con "/": senza, "debug/" escludeva anche
# frontend/battle/debug/, che invece è codice sorgente da versionare.
/.claude/
/debug/
/reports/

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# --- Distribution / packaging (PyInstaller incluso) ---
build/
dist/
*.egg-info/
*.egg
MANIFEST

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Ambienti virtuali / segreti ---
.env
.env.*
.venv/
env/
venv/
ENV/

# --- Cache strumenti ---
.mypy_cache/
.ruff_cache/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
gamecore/debug_module/README.md
frontend/battle/atmosphere/README.md
frontend/battle/endgame/README.md
frontend/battle/alert/README.md
